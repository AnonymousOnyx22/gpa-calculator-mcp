{
  "name": "gpa-calculator-mcp",
  "version": "0.1.0",
  "description": "GPA calculator MCP server. Calculate GPA, weighted grades, final grade, and convert letter grades. Works offline with no account.",
  "type": "module",
  "main": "build/src/index.js",
  "bin": {
    "gpa-calculator-mcp": "build/src/index.js"
  },
  "files": [
    "build/src",
    "README.md",
    "llms.txt",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/src/index.js', 0o755)\"",
    "test": "vitest run",
    "start": "node build/src/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "gpa",
    "gpa calculator",
    "gpa calculator mcp",
    "grade calculator",
    "final grade",
    "final grade calculator",
    "weighted grade",
    "weighted gpa",
    "letter grade conversion",
    "grade conversion",
    "mcp",
    "mcp server",
    "mcp-server",
    "model-context-protocol",
    "grade point average",
    "gpa-calculator",
    "gpa-calculator-mcp",
    "grades",
    "calculator",
    "percentage",
    "student",
    "students",
    "education",
    "edtech",
    "ai-agent",
    "claude",
    "chatgpt",
    "cursor"
  ],
  "author": "AnonymousOnyx22",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnonymousOnyx22/gpa-calculator-mcp.git"
  },
  "homepage": "https://github.com/AnonymousOnyx22/gpa-calculator-mcp#readme",
  "bugs": {
    "url": "https://github.com/AnonymousOnyx22/gpa-calculator-mcp/issues"
  },
  "mcpName": "io.github.AnonymousOnyx22/gpa-calculator-mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
